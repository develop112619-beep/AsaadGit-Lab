      "source": [
        "import time, cv2, numpy as np\n",
        "from base64 import b64decode\n",
        "from IPython.display import display, Javascript, Image\n",
        "from google.colab.output import eval_js\n",
        "\n",
        "def start_camera():\n",
        "    display(Javascript('''\n",
        "      async function startCam() {\n",
        "        const video = document.createElement('video');\n",
        "        video.style.width = '240px';\n",
        "        const stream = await navigator.mediaDevices.getUserMedia({video: true});\n",
        "        document.body.appendChild(video);\n",
        "        video.srcObject = stream;\n",
        "        await video.play();\n",
        "        window.cam = {video: video, stream: stream, canvas: document.createElement('canvas')};\n",
        "        google.colab.output.setIframeHeight(document.documentElement.scrollHeight, true);\n",
        "      }\n",
        "    '''))\n",
        "    eval_js('startCam()')\n",
        "\n",
        "def get_frame(quality=0.6):\n",
        "    data = eval_js('''\n",
        "      (function() {\n",
        "        const c = window.cam;\n",
        "        c.canvas.width = c.video.videoWidth;\n",
        "        c.canvas.height = c.video.videoHeight;\n",
        "        c.canvas.getContext('2d').drawImage(c.video, 0, 0);\n",
        "        return c.canvas.toDataURL('image/jpeg', %s);\n",
        "      })()\n",
        "    ''' % quality)\n",
        "    jpg = b64decode(data.split(',')[1])\n",
        "    return cv2.imdecode(np.frombuffer(jpg, np.uint8), cv2.IMREAD_COLOR)\n",
        "\n",
        "def stop_camera():\n",
        "    eval_js('window.cam.stream.getTracks().forEach(t => t.stop())')\n",
        "\n",
        "print(\"Camera helpers ready\")"
      ]
    },
