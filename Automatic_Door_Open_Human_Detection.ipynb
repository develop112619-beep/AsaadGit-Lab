        "import time\n",
        "import cv2\n",
        "import paho.mqtt.client as mqtt\n",
        "from ultralytics import YOLO\n",
        "\n",
        "from IPython.display import display, Image\n",
        "\n",
        "# =====================================\n",
        "# INITIALIZE YOLO MODEL\n",
        "# =====================================\n",
        "model = YOLO(\"yolov8n.pt\")\n",
        "\n",
        "# =====================================\n",
        "# SETTINGS\n",
        "# =====================================\n",
        "\n",
        "TARGET = \"person\"\n",
        "\n",
        "ON_AFTER = 2\n",
        "OFF_AFTER = 3\n",
        "\n",
        "RUN_SECONDS = 120\n",
        "\n",
        "BROKER = \"broker.hivemq.com\"\n",
        "PORT = 1883\n",
        "\n",
        "TOPIC = \"ssse/w4/asaad042/cmd\"\n",
        "\n",
        "# =====================================\n",
        "# MQTT CONNECTION\n",
        "# =====================================\n",
        "\n",
        "client = mqtt.Client(\n",
        "    callback_api_version=mqtt.CallbackAPIVersion.VERSION2,\n",
        "    client_id=\"YOLO-Camera-Controller\"\n",
        ")\n",
        "\n",
        "client.connect(BROKER, PORT, 60)\n",
        "client.loop_start()\n",
        "\n",
        "time.sleep(2)\n",
        "\n",
        "print(\"MQTT CONNECTED\")\n",
        "\n",
        "# =====================================\n",
        "# SEND COMMAND\n",
        "# =====================================\n",
        "\n",
        "def send(msg):\n",
        "\n",
        "    client.publish(TOPIC, msg, qos=0)\n",
        "\n",
        "    print(\"MQTT COMMAND:\", msg.upper())\n",
        "\n",
        "\n",
        "# =====================================\n",
        "# START CAMERA\n",
        "# =====================================\n",
        "\n",
        "start_camera()\n",
        "time.sleep(1)\n",
        "\n",
        "hits = 0\n",
        "misses = 0\n",
        "\n",
        "last_sent = \"close\"\n",
        "\n",
        "view = None\n",
        "t0 = time.time()\n",
        "\n",
        "try:\n",
        "\n",
        "    while time.time() - t0 < RUN_SECONDS:\n",
        "\n",
        "        frame = get_frame()\n",
        "\n",
        "        # YOLO PERSON DETECTION\n",
        "        result = model(\n",
        "            frame,\n",
        "            verbose=False,\n",
        "            conf=0.4\n",
        "        )[0]\n",
        "\n",
        "        seen = TARGET in [\n",
        "            result.names[int(c)]\n",
        "            for c in result.boxes.cls\n",
        "        ]\n",
        "\n",
        "        # DETECTION COUNTER\n",
        "        if seen:\n",
        "\n",
        "            hits += 1\n",
        "            misses = 0\n",
        "\n",
        "        else:\n",
        "\n",
        "            misses += 1\n",
        "            hits = 0\n",
        "\n",
        "        msg = None\n",
        "\n",
        "        # PERSON DETECTED\n",
        "        if hits >= ON_AFTER:\n",
        "\n",
        "            msg = \"open\"\n",
        "\n",
        "        # PERSON NOT DETECTED\n",
        "        elif misses >= OFF_AFTER:\n",
        "\n",
        "            msg = \"close\"\n",
        "\n",
        "        # SEND ONLY WHEN STATE CHANGES\n",
        "        if msg and msg != last_sent:\n",
        "\n",
        "            send(msg)\n",
        "            last_sent = msg\n",
        "\n",
        "        # CAMERA DISPLAY\n",
        "        annotated = result.plot()\n",
        "\n",
        "        img = Image(\n",
        "            data=cv2.imencode(\n",
        "                \".jpg\", annotated\n",
        "            )[1].tobytes()\n",
        "        )\n",
        "\n",
        "        if view is None:\n",
        "\n",
        "            view = display(img, display_id=True)\n",
        "\n",
        "        else:\n",
        "\n",
        "            view.update(img)\n",
        "\n",
        "except KeyboardInterrupt:\n",
        "\n",
        "    print(\"Stopped\")\n",
        "\n",
        "finally:\n",
        "\n",
        "    stop_camera()\n",
        "\n",
        "    send(\"close\")\n",
        "\n",
        "    time.sleep(1)\n",
        "\n",
        "    client.loop_stop()\n",
        "    client.disconnect()\n",
        "\n",
        "    print(\"AI DOOR SYSTEM STOPPED\")"
      ]
    },
